{
  "name": "@zo-stack/web",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "check:fix": "vp check --fix",
    "dev": "pnpm dotenvx run -f ../../packages/env/.env --ignore=MISSING_ENV_FILE -- vp dev",
    "build": "pnpm dotenvx run -f ../../packages/env/.env --ignore=MISSING_ENV_FILE -- vp build",
    "build:cloudflare": "cross-env NITRO_PRESET=cloudflare_module vp run build",
    "deploy:cloudflare": "vp run build:cloudflare && wrangler deploy",
    "preview": "pnpm dotenvx run -f ../../packages/env/.env --ignore=MISSING_ENV_FILE -- vp preview",
    "test:e2e": "vp exec playwright test",
    "test:unit": "vp test --run src/__tests__",
    "test:breakpoints": "vp exec playwright test __e2e__/breakpoints.spec.ts --global-timeout=600000",
    "ui": "vpx shadcn@latest"
  },
  "dependencies": {
    "@fontsource-variable/jost": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@zo-stack/seo": "workspace:*",
    "@zo-stack/ui": "workspace:*",
    "lenis": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "catalog:",
    "schema-dts": "catalog:",
    "three": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@mdx-js/rollup": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/devtools-a11y": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@zo-stack/env": "workspace:*",
    "@zo-stack/tsconfig": "workspace:*",
    "cross-env": "catalog:",
    "nitro": "catalog:",
    "oxc-transform-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-imagetools": "catalog:",
    "wrangler": "catalog:"
  }
}
