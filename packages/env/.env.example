# ============================================================
# 🌍 Web (required)
# ============================================================

# ✅ required in production builds - Public origin of the site (no trailing slash, no path).
# Used for canonical URLs, Open Graph images, robots.txt, and sitemap.xml.
VITE_SITE_URL="http://localhost:3000"

# ============================================================
# 🗄️ Database (opt-in, only needed once the app imports @zo-stack/db)
# ============================================================

# Postgres connection string. VPS Postgres or Supabase.
# For Supabase on Vercel/Cloudflare, use the transaction pooler URL (port 6543).
# DATABASE_URL="postgresql://postgres:password@localhost:5432/zo-stack"

# ============================================================
# 🔐 Auth (opt-in, only needed once the app imports @zo-stack/auth)
# ============================================================

# Generate with: vp run auth:secret
# BETTER_AUTH_SECRET="replace-with-at-least-32-characters"
